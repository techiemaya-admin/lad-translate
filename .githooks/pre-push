#!/usr/bin/env bash
# Refuse to push if gitleaks finds a credential.
#
# This exists because GitHub Actions minutes are billable on private
# repositories, so the CI gate cannot be relied on. It is also the better place
# for this check: CI catches a secret AFTER it reaches GitHub, where it must be
# treated as compromised regardless of what happens next. A pre-push hook
# catches it while it is still only on this machine.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass deliberately, and only when you are certain:
#     git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
BIN="$ROOT/.local/bin/gitleaks"

if [ ! -x "$BIN" ]; then
  echo "pre-push: gitleaks not found at .local/bin/gitleaks" >&2
  echo "          install it with tools/install_gitleaks.sh, or skip with --no-verify" >&2
  exit 1
fi

echo "pre-push: scanning history for credentials..."
# `detect` over history, not --no-git: the latter ignores .gitignore and walks
# the model weights and Go module cache, reporting hundreds of false hits.
if ! "$BIN" detect --source "$ROOT" --config "$ROOT/.gitleaks.toml" \
      --redact --no-banner --exit-code 1; then
  cat >&2 <<'MSG'

pre-push: BLOCKED. A value matching a credential pattern is in this history.

  If it is real     rotate it first, then remove it from history. A new commit
                    deleting the line is not enough: the old commit still has it.

  If it is not      change the value rather than allowlisting the file. An
                    allowlist would hide a real secret landing there later.

  LiveKit's devkey/secret pair used for local development is published by
  LiveKit and is not a secret.

MSG
  exit 1
fi
echo "pre-push: clean"
