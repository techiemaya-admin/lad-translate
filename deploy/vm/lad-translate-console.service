[Unit]
Description=LAD Live Translation operator console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ladtranslate
Group=ladtranslate
WorkingDirectory=/opt/lad-translate
# Three files, last one wins. session.env for LAD_CONTROL_SCHEMA and
# LAD_TRANSLATE_TENANT - the channel map lives in the same tenant schema the
# session writes to, and the console must not be told a different tenant than
# the session it manages. secrets.env for LAD_DATABASE_URL. console.env last,
# so nothing in the other two can shadow the sign-in configuration.
EnvironmentFile=/etc/lad-translate/session.env
EnvironmentFile=/etc/lad-translate/secrets.env
EnvironmentFile=/etc/lad-translate/console.env

# 127.0.0.1 on purpose. Caddy terminates TLS and applies basic auth in front of
# this; binding it outward would put a surface that restarts sessions and
# rewrites settings on the internet with no credentials at all.
ExecStart=/opt/lad-translate/.venv/bin/python tools/serve_console.py \
    --host 127.0.0.1 --port 8090

Restart=always
RestartSec=5

# It manages units through a narrow sudoers rule rather than running as root.
# A web service that IS root is a browser one bug away from the box.
NoNewPrivileges=false
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
