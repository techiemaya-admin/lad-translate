# Non-secret config for the session worker. bootstrap.sh installs this to
# /etc/lad-translate/session.env; edit it there per event.
#
# Secrets are NOT here. /etc/lad-translate/secrets.env is written from Secret
# Manager at boot and holds LAD_DATABASE_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET.

LOG_LEVEL=INFO
LAD_CONTROL_SCHEMA=lad_dev

# What this process dials. Local, and NOT through Caddy: routing traffic out
# to TLS to come straight back would be pointless even where it works.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880

# What the join page hands to browsers. Only used here for session rows; the
# authoritative copy is Cloud Run's env-cloudrun-develop.yaml, and the two
# must agree.
LIVEKIT_URL=wss://translate-sfu-dev.mrlads.com

LAD_TRANSLATE_TARGETS=fr,ar
LAD_TRANSLATE_EVENT=LAD Live Translation

# "tiny" is the dev Mac's compromise, not this machine's. On an L4, "small"
# is the honest starting point - README, "Why the demo runs Whisper tiny".
# Sweep it against the emit interval before an event rather than after.
LAD_TRANSLATE_STT_MODEL=small

# 3.0s emit / 6.0s window is the only pair measured to hold 0% drop through a
# real SFU. 1.0/8.0 shed 88.5% of audio. Do not change one without the other.
LAD_TRANSLATE_EMIT_INTERVAL=3.0
LAD_TRANSLATE_WINDOW=6.0

# Governs BOTH the wait for a speaker and the idle cap once one arrives.
LAD_TRANSLATE_WAIT=900
