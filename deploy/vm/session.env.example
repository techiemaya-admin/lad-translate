# Non-secret config for the session worker. bootstrap.sh installs this to
# /etc/lad-translate/session.env; edit it there per event.
#
# Secrets are NOT here. /etc/lad-translate/secrets.env is written from Secret
# Manager at boot and holds LAD_DATABASE_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET.

LOG_LEVEL=INFO
# lad-translate's OWN control schema, NOT Mr LAD's lad_dev - that table is
# the platform's, with a different shape and 20 live tenants.
LAD_CONTROL_SCHEMA=lad_translate_dev

# Tenant slug looked up in the control schema above.
LAD_TRANSLATE_TENANT=techiemaya

# What this process dials. Local, and NOT through Caddy: routing traffic out
# to TLS to come straight back would be pointless even where it works.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880

# What the join page hands to browsers. Only used here for session rows; the
# authoritative copy is Cloud Run's env-cloudrun-develop.yaml, and the two
# must agree.
LIVEKIT_URL=wss://translate-sfu-dev.mrlads.com

LAD_TRANSLATE_TARGETS=fr,ar
LAD_TRANSLATE_EVENT=LAD Live Translation

# tiny, and the reason is live audio rather than this machine being slow.
#
# On the fixture, small costs ~0.70s per 4s window here and looks comfortable.
# On a live phone the same model, box, window and thread count costs 8.63s -
# twelve times more - and the adapter says so itself:
#
#   STT cannot keep up: a pass costs more than the emit interval
#   pass_cost_s 8.63  window_s 4.0  cost_per_audio_second 2.169
#
# Resampling is not inside that timer, so the difference is the audio: noisy
# phone input makes Whisper decode much longer before it stops. The result was
# 72 seconds of a listener's speech dropped and a transcript of fragments,
# which reads as mistranslation and is not.
#
# tiny costs 0.26s against small's 1.39s on the same benchmark, roughly 5x, so
# it absorbs that penalty. It buys accuracy back to about 20% WER from 9.4% on
# the fixture - worse words, but words. Losing most of the audio is not a
# quality trade, it is no output at all.
#
# Revisit with a headset or a better mic before assuming tiny is the ceiling.
LAD_TRANSLATE_STT_MODEL=tiny

# No GPU on this VM and, per the benchmark, none needed. Set to cuda only on a
# box that actually has one.
LAD_TRANSLATE_STT_DEVICE=cpu

# faster-whisper, NOT fastconformer, until FastConformer has voice activity
# detection. This is a revert, and the reason matters more than the value.
#
# On the holmes.wav fixture FastConformer is better on every axis measured:
# 2.7% WER against 3.4%, RTF 0.07, French latency p50 0.581s against ~4s. On a
# live phone in a room it produced this:
#
#   span 24.0s  "none seldom didn't sound like failing right hello it's hello"
#   span 48.7s  "you hear me thomas said you i can i can ya okay let me see one"
#
# Those are not mishearings. The adapter has NO silence handling - grep it for
# vad, rms or silence and there is nothing, where stt_whisper.py has twenty
# five references and logs "VAD filter removed 00:05.782 of audio" as it runs.
# Without a gate, room tone becomes words.
#
# The delay followed from the same thing. The chunker commits at max_words=25
# or a clause boundary, and noise-words accumulate slowly, so filling 25 words
# took 24 to 49 seconds and nothing was published until it did. The commit
# reasons were mostly max_words rather than clause. The French was a faithful
# translation of nonsense.
#
# The fixture never showed it because clean read prose has no room tone. Every
# number above was measured on that file.
STT_BACKEND=faster-whisper

# 0ms 80ms 480ms 1040ms. 480ms is the balance the adapter argues for; the
# lookahead is subtracted from the latency budget before translation starts.
LAD_TRANSLATE_LOOKAHEAD=480ms

# Voice activity detection for the streaming backend. --vad or --no-vad.
#
# On is the only sane setting in a room. Without it FastConformer made words out
# of room tone: 24 and 48 second spans of invented text between real sentences,
# which filled the chunker to max_words and left a listener waiting half a
# minute. --no-vad exists to measure against a clean file, where the gate can
# only cost time and cannot help.
LAD_TRANSLATE_VAD_FLAG=--vad

# Pinned, NOT left to ctranslate2's default. More threads is not better and is
# sharply worse past a point - measured on a 32 vCPU n2, one 6s window against
# the 3.0s budget:
#
#     32 threads -> p95 2.81s (1.07x headroom, one bad window from shedding)
#     16 threads -> p95 0.68s (4.44x)
#      8 threads -> p95 0.80s (3.73x)
#      4 threads -> p95 1.05s (2.86x)
#
# 8 leaves the other half of a 16 vCPU box for the MT and TTS fan-out, LiveKit
# and Caddy. Re-run deploy/vm/benchmark_stt.py after ANY resize: left at 0 this
# tracks core count, so a bigger machine silently changes latency.
LAD_TRANSLATE_STT_THREADS=8

# The delay a listener feels is mostly this number. The chunker waits a whole
# emit interval before it says anything; STT, translation and TTS together add
# about a second (measured glass_to_glass_s 0.84-1.18s on this box).
#
# Shorter is not free. Measured on the develop VM, whisper small, 8 threads,
# same fixture, varying only these two:
#
#     emit  window   WER     CPU per 75s of audio
#     3.0   6.0      3.4%    17.9s
#     1.5   4.0      6.0%    40.2s
#     1.0   3.0     10.1%    51.4s
#
# Every one of them passes the timing check here, so CPU is not what bounds
# this - accuracy is. Halving the delay roughly doubles the word error rate,
# because a shorter window gives Whisper less context to work with.
#
# 1.5/4.0 is the chosen point: about 2.5s to a listener instead of 4s, at 6%.
# Sub-second is not reachable at any window size, because Whisper needs a
# window before it can transcribe at all. That needs the streaming transducer
# in adapters/stt_fastconformer.py, which has never been run.
#
# The two move together. Re-measure rather than adjust one on its own.
LAD_TRANSLATE_EMIT_INTERVAL=1.5
LAD_TRANSLATE_WINDOW=4.0

# Governs BOTH the wait for a speaker and the idle cap once one arrives.
LAD_TRANSLATE_WAIT=900
