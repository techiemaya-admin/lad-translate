# TLS termination for the SFU's signalling connection.
#
# Browsers dial wss://, and a page served over https cannot open an insecure
# WebSocket. Caddy gets a real Let's Encrypt certificate for this name, which
# also means the Cloud Run join service can use ONE url for both
# LIVEKIT_URL and LIVEKIT_INTERNAL_URL - the SDK trusts a public CA. That is
# only untrue locally, where Caddy signs with its own internal CA and the
# Python SDK rejects it (README, "Two URLs, and they must differ").
#
# Media does NOT pass through here. WebRTC goes straight to UDP 50000-60000 /
# TCP 7881 on the VM's external IP; proxying it would be pointless and slow.

{$LAD_TRANSLATE_SFU_HOST} {
	# The operator console, IF it has a password. bootstrap.sh writes
	# conf.d/console.conf only when the secret exists, and a glob that matches
	# nothing is not an error.
	#
	# It used to be inline here with basic_auth referencing an environment
	# variable. With no secret that expanded to nothing, Caddy refused the whole
	# config - "username and password cannot be empty or missing" - and failed
	# to start. That takes TLS down for the SFU, so a missing OPTIONAL console
	# password made every listener unreachable. An optional feature must not be
	# able to break the required one.
	import /etc/caddy/conf.d/*.conf

	# LiveKit's signalling connection. Last, so a more specific handle in
	# conf.d wins; Caddy matches on specificity rather than order, but keeping
	# this at the bottom matches how it reads.
	handle {
		reverse_proxy localhost:7880
	}
}
