# TLS termination for the SFU's signalling connection.
#
# Browsers dial wss://, and a page served over https cannot open an insecure
# WebSocket. Caddy gets a real Let's Encrypt certificate for this name, which
# also means the Cloud Run join service can use ONE url for both
# LIVEKIT_URL and LIVEKIT_INTERNAL_URL - the SDK trusts a public CA. That is
# only untrue locally, where Caddy signs with its own internal CA and the
# Python SDK rejects it (README, "Two URLs, and they must differ").
#
# Media does NOT pass through here. WebRTC goes straight to UDP 50000-60000 /
# TCP 7881 on the VM's external IP; proxying it would be pointless and slow.

{$LAD_TRANSLATE_SFU_HOST} {
	# The operator console. It can restart sessions and rewrite settings, so it
	# is behind basic auth and bound to localhost on the app side - unlike the
	# join service, which is deliberately unauthenticated because a listener
	# scans a QR code and has no credentials.
	#
	# Ordered before the catch-all: Caddy matches the most specific route, but
	# writing it first keeps the intent obvious to anyone editing this.
	handle /console* {
		basic_auth {
			operator {$LAD_TRANSLATE_CONSOLE_HASH}
		}
		uri strip_prefix /console
		reverse_proxy localhost:8090
	}

	# Everything else is LiveKit's signalling connection.
	handle {
		reverse_proxy localhost:7880
	}
}
