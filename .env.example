# Local Postgres, started by tools/pg.sh
LAD_DATABASE_URL=postgresql://lad@127.0.0.1:55432/salesmaya_agent

# Control plane schema. Holds the tenants table only.
# There is deliberately no default: an unresolved schema must fail, not
# silently fall back to a shared one.
LAD_CONTROL_SCHEMA=lad_dev

LOG_LEVEL=INFO

STT_BACKEND=faster-whisper
MT_BACKEND=opus-mt
TTS_BACKEND=piper
